<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Acutis IVC</title>

    <link rel="stylesheet" href="/css/Catequista_Inicial.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

</head>

<body>

<div class="particles"></div>

<header id="header">

    <div class="logo">
        <img src="/logo.jpg">
    </div>

    <nav>

        <a href="/planejamento">Planejamento</a>

        <a href="/catequizandos">Frequência</a>

        <a href="/materiais">Materiais</a>

        <a href="/grupos">Grupos</a>

    </nav>

    <a href="/perfil" class="perfil">

    <i class="fa-solid fa-user"></i>

</a>

</header>


<section class="hero">

    <div class="cross"></div>

    <div class="leaf leaf-left"></div>

    <div class="leaf leaf-right"></div>

    <div class="hero-content">

        <img src="/logo.jpg" class="hero-logo">

        <h1>Acutis IVC</h1>

        <p>
            Plataforma para planejamento, frequência e organização da catequese.
        </p>

        <div class="buttons">

            <a href="/planejamento" class="btn-primary">
                Acessar sistema
            </a>

            <a href="#modulos" class="btn-secondary">
                Conhecer
            </a>

        </div>

    </div>

</section>


<section id="modulos">

    <div class="titulo">

        <span>Módulos</span>

        <h2>Tudo em um único lugar</h2>

    </div>

    <div class="cards">

        <div class="card">

            <div class="icon">
                <i class="fa-solid fa-calendar-days"></i>
            </div>

            <h3>Planejamento</h3>

            <p>
                Organize encontros, roteiros e objetivos da catequese.
            </p>

            <a href="/planejamento">
                Abrir
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>


        <div class="card">

            <div class="icon">
                <i class="fa-solid fa-clipboard-check"></i>
            </div>

            <h3>Frequência</h3>

            <p>
                Controle a presença dos catequizandos.
            </p>

            <a href="/catequizandos">
                Abrir
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>


        <div class="card">

            <div class="icon">
                <i class="fa-solid fa-book-open"></i>
            </div>

            <h3>Materiais</h3>

            <p>
                Livros, documentos, roteiros e recursos.
            </p>

            <a href="/materiais">
                Abrir
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>


        <div class="card">

            <div class="icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <h3>Grupos</h3>

            <p>
                Gerencie seus grupos de catequese.
            </p>

            <a href="/grupos">
                Abrir
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>

    </div>

</section>


<section class="sobre">

    <div class="imagem">

        <img src="/logo.jpg">

    </div>

    <div class="texto">

        <span>Sobre</span>

        <h2>Inspirado em São Carlo Acutis</h2>

        <p>
            O Acutis IVC nasceu para auxiliar catequistas na missão de evangelizar,
            reunindo planejamento, frequência, materiais e organização dos grupos
            em um ambiente moderno, intuitivo e acolhedor.
        </p>

        <a href="#">
            Saiba mais
        </a>

    </div>

</section>


<footer>

    <div class="footer-logo">

        <img src="/logo.jpg">

    </div>

    <div>

        <h4>Acutis IVC</h4>

        <p>
            Diocese de Bagé
        </p>

    </div>

    <div>

        <a href="/planejamento">Planejamento</a>

        <a href="/catequizandos">Frequência</a>

        <a href="/materiais">Materiais</a>

        <a href="/grupos">Grupos</a>

    </div>

</footer>

</body>

</html>